# 1Password 参照のみを記載した env テンプレート（秘密は含まない・commit 可能）。
#
# 使い方:
#   op run --env-file=.env.op -- docker compose up -d
#   op run --env-file=.env.op -- docker compose up -d --build
#
# 事前に 1Password の item「Development/CalendarRabbit」へ以下のフィールドを作成すること。
# （DB 系はローカル開発の既定値と一致させる。API キー系のみ実キー / concealed）
#   LLM_PROVIDER         … deepseek（切り戻す場合は claude）
#   DEEPSEEK_API_KEY     … DeepSeek API キー（実キー / concealed）
#   DEEPSEEK_MODEL       … deepseek-v4-pro（公式 API が受け付ける名: deepseek-flash / deepseek-v4-pro）
#   DEEPSEEK_BASE_URL    … https://api.deepseek.com
#   SEARCH_PROVIDER      … tavily
#   SEARCH_API_KEY       … 検索 API キー（実キー / concealed）
#   SEARCH_MAX_RESULTS   … 10
#   CLAUDE_API_KEY       … Claude API キー（実キー / concealed / 切り戻し用）
#   CLAUDE_MODEL         … claude-sonnet-4-6
#   DB_USER              … calendarrabbit
#   DB_PASSWORD          … calendarrabbit
#   DB_NAME              … calendarrabbit
#   MYSQL_ROOT_PASSWORD  … rootpassword
#   ALLOWED_ORIGINS      … http://localhost:5173,http://localhost:8081
#
# Google Calendar 連携（任意機能）を使う場合のみ、以下のフィールドを 1Password に作成し
# 末尾のコメントアウトを解除する。未設定なら連携は休眠し DB のみで動作する。
#   GOOGLE_OAUTH_CLIENT_ID      … Google Cloud OAuth クライアントID
#   GOOGLE_OAUTH_CLIENT_SECRET  … Google Cloud OAuth クライアントシークレット（concealed）
#   GOOGLE_OAUTH_REDIRECT_URL   … 例: http://localhost:8080/api/google/callback
#   GOOGLE_TOKEN_ENC_KEY        … refresh token 暗号鍵（任意長・concealed）

LLM_PROVIDER=op://Development/CalendarRabbit/LLM_PROVIDER
DEEPSEEK_API_KEY=op://Development/CalendarRabbit/DEEPSEEK_API_KEY
DEEPSEEK_MODEL=op://Development/CalendarRabbit/DEEPSEEK_MODEL
DEEPSEEK_BASE_URL=op://Development/CalendarRabbit/DEEPSEEK_BASE_URL
SEARCH_PROVIDER=op://Development/CalendarRabbit/SEARCH_PROVIDER
SEARCH_API_KEY=op://Development/CalendarRabbit/SEARCH_API_KEY
SEARCH_MAX_RESULTS=op://Development/CalendarRabbit/SEARCH_MAX_RESULTS
CLAUDE_API_KEY=op://Development/CalendarRabbit/CLAUDE_API_KEY
CLAUDE_MODEL=op://Development/CalendarRabbit/CLAUDE_MODEL
DB_USER=op://Development/CalendarRabbit/DB_USER
DB_PASSWORD=op://Development/CalendarRabbit/DB_PASSWORD
DB_NAME=op://Development/CalendarRabbit/DB_NAME
MYSQL_ROOT_PASSWORD=op://Development/CalendarRabbit/MYSQL_ROOT_PASSWORD
ALLOWED_ORIGINS=op://Development/CalendarRabbit/ALLOWED_ORIGINS

# Google Calendar 連携
GOOGLE_OAUTH_CLIENT_ID=op://Development/CalendarRabbit/GOOGLE_OAUTH_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=op://Development/CalendarRabbit/GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_OAUTH_REDIRECT_URL=op://Development/CalendarRabbit/GOOGLE_OAUTH_REDIRECT_URL
GOOGLE_TOKEN_ENC_KEY=op://Development/CalendarRabbit/GOOGLE_TOKEN_ENC_KEY
